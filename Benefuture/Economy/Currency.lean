/-
  Benefuture.Economy.Currency
  Formalization of the Benefuture Currency System grounded in Metric Models (MM).
  Corresponds to: Bf_Pseudocode.txt L82-103, and Benefuture currency.txt

  "C := {C_i} | C_i ↔ MM_j ∈ TopModels(MM_Acc>Th, Dn_i) ,compete(ΔV / (ΔResource«Rc» + Δt));"
  "TP_Gen(A) :: ∀c ∈ CNet(relevantDn(A)) : c → Gen(TP_{k_c}(A)):price_c=(MM_Me((Rc[],t[])→A|RA)-MM_Pr(V←A)+PE_hold);"
  "ΔC_i → ΔC_j iff ∃TP(A : Dn_i → Dn_j), !trading, !Arbitrage;"
-/

import Benefuture.Math.Order
import Benefuture.Ontology.Entity
import Benefuture.Measurement.MetricModel

namespace Benefuture.Economy

open Benefuture.Math
open Benefuture.Ontology
open Benefuture.Measurement

/-- 
  Benefuture Currency (C_i ∈ T):
  A currency is NOT fiat and NOT arbitrary.
  A currency MUST be backed by a qualified Metric Model in TopModels.
  C_i ↔ MM_j ∈ TopModels(MM_Acc > Th, Dn_i).
  `statusBar` is the bar the domain sets (`status_bar` by the domain's status, ruling 8.35, or
  `relative_status_bar` against the alternative, ruling 8.41); qualification never falls below the
  discovery floor whatever bar is recorded.
-/
structure Currency extends Thing where
  backingModel : MetricModel
  statusBar    : Int
  h_qualified  : is_qualified_top_model statusBar backingModel

/-- Coercion: Every Currency is canonically a Thing in Reality. -/
instance : Coe Currency Thing where
  coe c := c.toThing


/-- Helper constructor for a Currency backed by a qualified Metric Model. -/
def Currency.mkSimple (id : String) (mm : MetricModel) (bar : Int)
    (h : is_qualified_top_model bar mm) : Currency :=
  { toThing := Thing.mkSimple id s!"currency_{mm.domain.name}" mm.domain.name 0,
    backingModel := mm, statusBar := bar, h_qualified := h }

/-- The domain of a currency is the domain of its underlying Metric Model. -/
def currency_domain (c : Currency) : Domain :=
  c.backingModel.domain

/-- 
  Probabilistic Escrow Schedule (PE ∈ T):
  Corresponds to: Bf_Pseudocode.txt L84:
  "ProbabilisticEscrow«PE»(CNet_i) : Pay_t0(C_i)(P(As(V, A, t_0) > 0)), hold(1 - P), Pay_gradual(As(V, A, t) | ∪MM_Me(CNet(relevantDn(A))));"
  upfront_fraction : P(V > 0) released immediately at t_0 (in micro-units)
  escrow_hold      : 1 - P held in escrow until backloaded verification arrives
-/
structure ProbabilisticEscrow extends Thing where
  predicted_confidence : Int  -- P ∈ [0, SCALE]
  h_conf_nonneg        : 0 ≤ predicted_confidence
  h_conf_bound         : predicted_confidence ≤ SCALE
  deriving Repr

instance : Coe ProbabilisticEscrow Thing where
  coe pe := pe.toThing


def ProbabilisticEscrow.mkSimple (id : String) (conf : Int) (h0 : 0 ≤ conf) (h1 : conf ≤ SCALE) : ProbabilisticEscrow :=
  { toThing := Thing.mkSimple id s!"escrow_{id}" "escrow_substrate" 0,
    predicted_confidence := conf, h_conf_nonneg := h0, h_conf_bound := h1 }

/-- Upfront release amount given a nominal payout and escrow schedule. -/
def upfront_payment (nominal : Int) (pe : ProbabilisticEscrow) : Int :=
  (nominal * pe.predicted_confidence) / SCALE

/-- Escrow hold amount. -/
def escrow_hold (nominal : Int) (pe : ProbabilisticEscrow) : Int :=
  nominal - upfront_payment nominal pe

/-- Theorem: Upfront payment plus escrow hold equals the exact nominal payment. -/
theorem escrow_conservation (nominal : Int) (pe : ProbabilisticEscrow) :
    upfront_payment nominal pe + escrow_hold nominal pe = nominal := by
  unfold escrow_hold
  omega

/-- 
  Transaction Proposal (TP ∈ T) generated by a Currency's Metric Model for an Action A.
  price_c = resourceCost - predictedValue + escrow_hold.
  Corresponds to: Bf_Pseudocode.txt L85-86.
-/
structure TransactionProposal extends Thing where
  currency         : Currency
  action           : Action
  targetDomain     : Domain
  resourceCost     : Int  -- Physical resource consumption debit (paid to Reality)
  predictedValue   : Int  -- Assessed value delta evaluated by currency's Metric Model
  escrow           : ProbabilisticEscrow
  h_res_pos        : 0 < resourceCost

/-- Coercion: Every TransactionProposal is canonically a Thing in Reality. -/
instance : Coe TransactionProposal Thing where
  coe tp := tp.toThing


/-- Helper constructor for TransactionProposal. -/
def TransactionProposal.mkSimple (id : String) (c : Currency) (act : Action) (dom : Domain) 
    (rc predV : Int) (esc : ProbabilisticEscrow) (hrc : 0 < rc) : TransactionProposal :=
  { toThing := Thing.mkSimple id s!"tp_{id}" dom.name 0,
    currency := c, action := act, targetDomain := dom,
    resourceCost := rc, predictedValue := predV, escrow := esc, h_res_pos := hrc }

/-- 
  Effective Price quoted by the currency network:
  Price = ResourceCost - PredictedValue + EscrowHold
-/
def quoted_price (tp : TransactionProposal) : Int :=
  tp.resourceCost - tp.predictedValue + escrow_hold tp.predictedValue tp.escrow

/-- 
  Net currency delta for the transactor:
  Net = Upfront_Payment - ResourceCost.
-/
def net_transaction_delta (tp : TransactionProposal) : Int :=
  upfront_payment tp.predictedValue tp.escrow - tp.resourceCost

/-- 
  MASTER THEOREM: Grounded No-Arbitrage Theorem.
  If an action generates zero predicted Value under the currency's backing Metric Model,
  the transaction results in a strictly negative currency balance.
  Pure financial churn without real value creation guaranteed to bleed resources.
-/
theorem no_arbitrage_pure_swap (tp : TransactionProposal) (h_novalue : tp.predictedValue = 0) :
    net_transaction_delta tp < 0 := by
  unfold net_transaction_delta upfront_payment
  rw [h_novalue]
  simp
  have hres := tp.h_res_pos
  omega

/-- Net balance resulting from a sequence of transaction proposals (e.g. cross-domain swaps). -/
def net_chain_delta (tps : List TransactionProposal) : Int :=
  tps.foldl (fun acc tp => acc + net_transaction_delta tp) 0

/-- Total physical resource cost debited across a chain of proposals. -/
def total_resource_cost (tps : List TransactionProposal) : Int :=
  tps.foldl (fun acc tp => acc + tp.resourceCost) 0

/--
  THEOREM 3: Closed-Cycle Arbitrage Elimination Theorem.
  For any non-empty closed sequence of transactions with zero net value creation 
  (e.g., pure financial arbitrage / circular trading loops), the net currency delta 
  is strictly negative and equals the negative sum of physical resource costs:
  Σ ΔC_k = -Σ RA_cost < 0.
-/
theorem closed_cycle_arbitrage_negative (tps : List TransactionProposal) 
    (h_nonempty : tps ≠ [])
    (h_novalue : ∀ tp ∈ tps, tp.predictedValue = 0) :
    net_chain_delta tps = -total_resource_cost tps ∧ net_chain_delta tps < 0 := by
  have h_delta_eq : ∀ tp ∈ tps, net_transaction_delta tp = -tp.resourceCost := by
    intro tp htp
    unfold net_transaction_delta upfront_payment
    rw [h_novalue tp htp]
    simp
  have h_chain_eq : net_chain_delta tps = -total_resource_cost tps := by
    unfold net_chain_delta total_resource_cost
    have h_fold : ∀ (l : List TransactionProposal) (acc1 acc2 : Int),
      (∀ tp ∈ l, net_transaction_delta tp = -tp.resourceCost) →
      acc1 = -acc2 →
      l.foldl (fun acc tp => acc + net_transaction_delta tp) acc1 =
      -(l.foldl (fun acc tp => acc + tp.resourceCost) acc2) := by
      intro l
      induction l with
      | nil =>
        intro acc1 acc2 _ hacc
        dsimp
        omega
      | cons head tail ih =>
        intro acc1 acc2 h_all hacc
        dsimp
        have h_hd : net_transaction_delta head = -head.resourceCost := 
          h_all head (List.Mem.head tail)
        have h_tl : ∀ tp ∈ tail, net_transaction_delta tp = -tp.resourceCost :=
          fun tp htp => h_all tp (List.Mem.tail head htp)
        apply ih (acc1 + net_transaction_delta head) (acc2 + head.resourceCost) h_tl
        omega
    exact h_fold tps 0 0 h_delta_eq rfl
  have h_cost_pos : total_resource_cost tps > 0 := by
    unfold total_resource_cost
    cases tps with
    | nil => contradiction
    | cons head tail =>
      dsimp
      have h_acc_le : ∀ (l : List TransactionProposal) (acc : Int), 
        acc ≤ l.foldl (fun a tp => a + tp.resourceCost) acc := by
        intro l
        induction l with
        | nil => intro acc; dsimp; omega
        | cons h t ih =>
          intro acc
          dsimp
          have h_step : acc ≤ acc + h.resourceCost := by
            have := h.h_res_pos; omega
          have h_tail := ih (acc + h.resourceCost)
          omega
      have h_tail_le := h_acc_le tail (0 + head.resourceCost)
      have h_head_pos := head.h_res_pos
      omega
  constructor
  · exact h_chain_eq
  · rw [h_chain_eq]
    omega

/-- 
  THEOREM 6: Epistemic Blackout Escrow Invariant.
  Under complete epistemic degradation / blackout (confidence = 0),
  upfront payment is identically zero and the entire nominal payment is held in escrow.
-/
theorem zero_confidence_escrow_blackout (nominal : Int) (pe : ProbabilisticEscrow) 
    (h_zero : pe.predicted_confidence = 0) :
    upfront_payment nominal pe = 0 ∧ escrow_hold nominal pe = nominal := by
  constructor
  · unfold upfront_payment
    rw [h_zero]
    simp
  · unfold escrow_hold upfront_payment
    rw [h_zero]
    simp


/-- 
  Currency Supply State (BTS Cycle, extends Thing):
  Cycle(C_i) :: CD(Gd) → ⊕Bal(E) ∧ ⊕Supply;
  {CD(Bd) | J(Ha) iff Disputed ∨ RA(Rc, t)} → ⊖Bal(E) ∧ ⊖Supply, OncePer(Ha).
  Corresponds to: Bf_Pseudocode.txt L97-99.
-/
structure CurrencySupplyState extends Thing where
  totalSupply : Int
  deriving Repr

instance : Coe CurrencySupplyState Thing where
  coe s := s.toThing


def CurrencySupplyState.mkSimple (id : String) (supply : Int) : CurrencySupplyState :=
  { toThing := Thing.mkSimple id s!"supply_{id}" "currency_ledger" 0,
    totalSupply := supply }

/-- Value creation expands the currency supply. -/
def mint_value_creation (state : CurrencySupplyState) (gain : Int) : CurrencySupplyState :=
  { state with totalSupply := state.totalSupply + gain }

/-- Harm or restorative penalty burns/contracts currency supply. -/
def burn_harm_penalty (state : CurrencySupplyState) (penalty : Int) : CurrencySupplyState :=
  { state with totalSupply := state.totalSupply - penalty }

/-- THEOREM: Value creation expands currency supply. -/
theorem value_creation_expands_supply (state : CurrencySupplyState) (gain : Int) (h : gain > 0) :
    (mint_value_creation state gain).totalSupply > state.totalSupply := by
  unfold mint_value_creation
  dsimp
  omega

/-- THEOREM: Harm penalty contracts currency supply. -/
theorem harm_penalty_contracts_supply (state : CurrencySupplyState) (penalty : Int) (h : penalty > 0) :
    (burn_harm_penalty state penalty).totalSupply < state.totalSupply := by
  unfold burn_harm_penalty
  dsimp
  omega

/-- 
  THEOREM: Price-Delta Duality Theorem.
  The quoted effective price of a transaction proposal is identically the exact 
  arithmetic negation of the net currency delta credited to the actor:
  Price = - (UpfrontPayment - ResourceCost) = - NetTransactionDelta.
  Consequently, a negative price is mathematically equivalent to the system paying 
  the actor to execute a value-positive transaction!
-/
theorem quoted_price_equals_negative_net_delta (tp : TransactionProposal) :
    quoted_price tp = - net_transaction_delta tp := by
  unfold quoted_price net_transaction_delta escrow_hold
  omega

/-- 
  THEOREM: Negative Effective Pricing Theorem (Article Nuance: Benefuture currency.txt L40).
  When the upfront predicted value payment of an action strictly exceeds its physical resource cost,
  the quoted effective price is strictly negative (quoted_price < 0).
  The system pays the sophont to transact, establishing the economic floor for baseline flourishing goods.
-/
theorem negative_price_when_upfront_exceeds_cost (tp : TransactionProposal) 
    (h_surplus : upfront_payment tp.predictedValue tp.escrow > tp.resourceCost) :
    quoted_price tp < 0 := by
  rw [quoted_price_equals_negative_net_delta]
  unfold net_transaction_delta
  omega

/-- 
  THEOREM: Competing Currency Pricing Disparity Theorem (Benefuture currency.txt L40-41).
  Consider an action evaluated by an in-domain currency (which confidently predicts positive upfront value)
  versus an out-of-domain currency (which has zero domain overlap, predicting 0 value).
  Both face the identical physical resource cost (rc > 0).
  The in-domain currency strictly quotes a lower price than the out-of-domain currency:
  Price(InDomain) < Price(OutOfDomain) = rc.
  The price differential provides an endogenous information signal directing sophonts 
  to the currency whose models best understand the transaction.
-/
theorem competing_currency_pricing_disparity 
    (inDomainTP outDomainTP : TransactionProposal)
    (h_same_rc : inDomainTP.resourceCost = outDomainTP.resourceCost)
    (h_out_novalue : outDomainTP.predictedValue = 0)
    (h_in_upfront_pos : upfront_payment inDomainTP.predictedValue inDomainTP.escrow > 0) :
    quoted_price inDomainTP < quoted_price outDomainTP ∧ quoted_price outDomainTP = inDomainTP.resourceCost := by
  have h_out_price : quoted_price outDomainTP = outDomainTP.resourceCost := by
    unfold quoted_price escrow_hold upfront_payment
    rw [h_out_novalue]
    simp
  have h_in_price : quoted_price inDomainTP = inDomainTP.resourceCost - upfront_payment inDomainTP.predictedValue inDomainTP.escrow := by
    unfold quoted_price escrow_hold
    omega
  constructor
  · rw [h_out_price, h_in_price, h_same_rc]
    omega
  · rw [h_out_price, h_same_rc]
/--
  THEOREM: Currency Epistemic Grounding Theorem (L82; rulings 8.35, 8.36, 8.41).
  A conforming Currency's backing Metric Model has accuracy (credence quality) at least its
  domain's status bar and at least the discovery floor 0.55; the composite ranking score plays no
  part in qualification.
-/
theorem currency_requires_qualified_model (c : Currency) :
    DISCOVERY_FLOOR ≤ c.backingModel.predictionAcc.brier_accuracy ∧
      c.statusBar ≤ c.backingModel.predictionAcc.brier_accuracy :=
  qualified_accuracy_bounds c.statusBar c.backingModel c.h_qualified

/-- 
  Resource Accounting (RA ∈ T):
  Corresponds to: Bf_Pseudocode.txt L83:
  "RcAccounting«RA»(Transaction«Tx») := ↓Cost / Δ↑(U, H) - Audit ∧ ↓Usage{Rc, t};"
  Tracks physical resource consumption, cost reduction relative to U/H gains, and anti-corruption audit verification.
-/
structure ResourceAccounting extends Thing where
  transactionId  : String
  resourceCost   : Int
  timeUsage      : Nat
  auditVerified  : Bool
  costPerValue   : Int
  deriving Repr, DecidableEq

/-- Coercion: Every ResourceAccounting record is canonically a Thing in Reality. -/
instance : Coe ResourceAccounting Thing where
  coe ra := ra.toThing


abbrev RcAccounting := ResourceAccounting
abbrev RA := ResourceAccounting
abbrev C := Currency
abbrev PE := ProbabilisticEscrow
abbrev TP := TransactionProposal

end Benefuture.Economy


