{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifeimage.invalid/schemas/card.schema.json",
  "title": "Domain card",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "label", "aliases", "description", "level", "anchors", "links", "axes", "radius",
               "arc", "status", "successors", "basemap_version", "provenance"],
  "$defs": {
    "unit": {"type": "number", "minimum": 0, "maximum": 1},
    "signed": {"type": "number", "minimum": -1, "maximum": 1},
    "link": {
      "type": "object", "additionalProperties": false, "required": ["id", "rel", "weight"],
      "properties": {"id": {"type": "string", "minLength": 1}, "rel": {"type": "string", "minLength": 1},
                     "weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "strict": {"type": "boolean"}}
    },
    "weighted_ref": {
      "type": "object", "additionalProperties": false, "required": ["id", "weight"],
      "properties": {"id": {"type": "string", "minLength": 1}, "weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}}
    }
  },
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "label": {"type": "string", "minLength": 1},
    "aliases": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["text", "lang"],
      "properties": {"text": {"type": "string", "minLength": 1}, "lang": {"type": "string", "minLength": 2}}}},
    "description": {"type": "string", "pattern": "^[^\\n]*$"},
    "level": {"enum": ["coarse", "fine", "finer"]},
    "anchors": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["source", "code", "label"],
      "properties": {"source": {"type": "string"}, "code": {"type": "string"}, "label": {"type": "string"}}}},
    "links": {"type": "array", "items": {"$ref": "#/$defs/link"}},
    "axes": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false,
      "required": ["abstract_tangible", "personal_global"],
      "properties": {"abstract_tangible": {"$ref": "#/$defs/signed"}, "personal_global": {"$ref": "#/$defs/signed"}}}]},
    "radius": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false,
      "required": ["complexity", "difficulty", "specificity", "composite"],
      "properties": {"complexity": {"$ref": "#/$defs/unit"}, "difficulty": {"$ref": "#/$defs/unit"},
                     "specificity": {"$ref": "#/$defs/unit"}, "composite": {"$ref": "#/$defs/unit"}}}]},
    "arc": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["start", "end"],
      "properties": {"start": {"type": "number", "minimum": 0, "exclusiveMaximum": 360},
                     "end": {"type": "number", "exclusiveMinimum": 0, "maximum": 720}}}]},
    "status": {"enum": ["score_only", "provisional", "stable", "tombstone"]},
    "successors": {"type": "array", "items": {"$ref": "#/$defs/weighted_ref"}},
    "basemap_version": {"type": "string", "minLength": 1},
    "provenance": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false,
      "required": ["source", "confidence"],
      "properties": {"source": {"type": "string"}, "confidence": {"type": "number", "minimum": 0, "exclusiveMaximum": 1}}}}
  }
}
