{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifeimage.invalid/schemas/evidence.schema.json",
  "title": "Evidence row v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["entity", "domains", "basemap_version", "channel", "sign", "magnitude", "date", "tier", "confidence",
               "provenance", "revoked"],
  "properties": {
    "entity": {"type": "string", "minLength": 1},
    "domains": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
      "required": ["id", "weight"],
      "properties": {"id": {"type": "string", "minLength": 1}, "weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}}}},
    "basemap_version": {"type": "string", "minLength": 1},
    "channel": {"enum": ["positive", "negative", "prediction", "relevance"]},
    "sign": {"enum": [1, -1]},
    "magnitude": {"type": "number", "minimum": 0},
    "date": {"type": "string", "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"},
    "tier": {"enum": ["claimed", "attested", "measured"]},
    "confidence": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["source", "span"],
      "properties": {"source": {"type": "string", "minLength": 1}, "span": {"type": "string"}}},
    "revoked": {"type": "boolean"}
  }
}
